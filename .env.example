# lark-twin 配置(全部有默认值,按需修改)
# 复制为 .env 放在项目根目录即可生效

# 区域: feishu(飞书国内版) | lark(Lark 国际版 larksuite.com)
# 只决定首次登录走哪边;登录后以凭证里记录的区域为准,切换用 larkx auth qr --region <feishu|lark>
LARKX_REGION=feishu

# 数据目录(凭证/消息库/数字人目录/agent 会话记录)
LARKX_HOME=~/.larkx

# 消息存储: 留空 = SQLite(自动存到 LARKX_HOME/messages.db)
# 用 MySQL 则填: mysql+pymysql://<user>:<password>@<host>:3306/<db>
LARKX_STORAGE_URL=

# 收到别人的消息就立刻标为已读: 所有会话的消息都会变成已读, 对方会看到"已读", 你自己的未读提醒也会消失。
# 默认关; 数字人收消息、翻聊天记录都不会改变已读状态
LARKX_MARK_READ=false
# 发消息时保住你的未读(匿名发送, 默认关)。关着时命令行、数字人都是普通发送, 直接发到目标会话:
# 对方看不到已读, 但你在这个会话的未读会清掉。
# 打开后会话里有未读就先发到你和自己的私聊, 再转发过去并撤回私聊里那条, 对方看到的是一条普通消息, 你的已读位置不动;
# 转发不成就退回普通发送。
# 回复某条消息(引用回复, 话题群里回进话题)不经转发, 被回复的那条会对对方显示已读
LARKX_KEEP_UNREAD=false

# ---- 数字人(larkx daemon) ----

# 用哪种 coding agent 驱动数字人: claude(Claude Code,一直开着的会话) | codex(每轮 codex exec resume 接着同一个会话)
LARKX_AGENT_BACKEND=claude

# 数字人工作目录: CLAUDE.md(人设和行为准则)、skill 都在这里。留空 = LARKX_HOME/agent
# 首次启动时从模板生成 CLAUDE.md,之后不会覆盖,可以直接改
LARKX_AGENT_HOME=

# 数字人专用的 Claude Code 配置目录(会话记录在这里)。留空 = LARKX_HOME/claude
LARKX_AGENT_CLAUDE_DIR=

# 数字人专用的 CODEX_HOME(codex 后端)。认证软链到你自己的 ~/.codex/auth.json。留空 = LARKX_HOME/codex
LARKX_AGENT_CODEX_DIR=

# 启动 agent 的命令: 填你平时启动 coding agent 的方式, 认证沿用你自己的配置。
# claude 后端: 如 claude, 或 ccd 这类启动器; 留空则用 Agent SDK 自带的 claude, 认证取下面两个变量(或当前环境里的同名变量)
LARKX_CLAUDE_CLI=
# codex 后端: 默认 codex, 认证沿用你自己的 codex login
LARKX_CODEX_CLI=codex
# 写了 key 记得 chmod 600 .env
# ANTHROPIC_BASE_URL=
# ANTHROPIC_AUTH_TOKEN=

# 模型。留空用 Claude Code 默认(用启动器时由启动器决定)
LARKX_AGENT_MODEL=

# 备用模型: 主模型被安全策略拦截时,Claude Code 会把整个会话切到备用模型。
# 必须填当前接入点可用的模型,否则一次误判就会让常驻会话每一轮都失败
LARKX_AGENT_FALLBACK_MODEL=

# 单轮处理超时(秒),超时后中断这一轮
LARKX_AGENT_TURN_TIMEOUT=1800

# agent 需要代理时写在这里(.env 里的变量会传给 agent)。注意 Codex 读的是大写变量
# HTTPS_PROXY=
# HTTP_PROXY=

# 长期记忆: 每天几点(本地时间)回顾当天的对话并整理记忆, -1 关闭
LARKX_MEMORY_REVIEW_HOUR=4
# 上下文用到自动压缩阈值的这个比例时, 先整理记忆再压缩(claude 后端)
LARKX_MEMORY_FLUSH_RATIO=0.85
# 每周几(0=周一 … 6=周日)在每日回顾之后再整理一次记忆(合并重复、删掉过期、旧内容归档到 memory/archive/); -1 关闭(默认)
LARKX_MEMORY_CONSOLIDATE_WEEKDAY=-1

# ---- 会话分类与清理(默认都关, 不改现有行为) ----
# 会话分类与关注度: 打开后每天回顾前给会话画像(本人发言、被 @、人数、飞书置顶、私聊对象是不是机器人),
# 给出建议的分类和关注度(重点关注 / 简单关注 / 只存不看); 每日回顾只看重点和简单关注的会话。
# 分类在网页"会话"页或 larkx groups 里按名字调整, 立即生效
LARKX_CHAT_GROUPS=false
# 消息保留天数: 只存不看的会话、简单关注的会话; 0 = 一直保留(默认)。重点关注的、还没画像的会话一直保留。
# 要打开 LARKX_CHAT_GROUPS 并配了天数, 才会在每天的会话画像之后清理一次(同时整理过期的收件箱、任务、控制请求、运行记录);
# 手动 larkx prune --dry-run 先看会删多少
LARKX_RETENTION_ARCHIVE_DAYS=0
LARKX_RETENTION_LIGHT_DAYS=0
# 建议分类时, 私聊机器人名字含这些词(逗号分隔)就算"需要你处理的通知"; 已内置审批、权限、日历等常见的
LARKX_BOT_ACTION_KEYWORDS=
# 整理方案(要先打开 LARKX_CHAT_GROUPS): 分身按本人的工作提出整理会话的调整, 私信给本人, 本人在私聊里同意哪条执行哪条,
# 都能撤销。打开后先提一次(回填了就在初始化记忆之后), 之后每周一次。只改本人自己飞书里的设置, 不对外发消息
LARKX_ORGANIZE=false
# 提哪几类改动(逗号分隔): 分类, 置顶, 免打扰, 标签。默认前三类。
# 标签 = 每个分类对应一个飞书标签, 只管本程序建的, 本人自己的标签(包括同名的)不动。
# (标记消息还没确认会不会顺带标已读, 暂不开放)
LARKX_ORGANIZE_ITEMS=分类,置顶,免打扰

# ---- 回填、简报、结构化记忆(默认都关, 不改现有行为) ----
# 首次启动回填最近多少天的聊天(只做一次, 不触发数字人、不标已读), 回填完分批初始化记忆(要开着每日回顾); 0 = 不回填
# 先用 larkx backfill --dry-run 看规模
LARKX_BACKFILL_DAYS=0
# 每天几点给本人私聊发工作简报(找你没回的、标记的、到期提醒、活跃会话; 周一附上周回顾), 如 09:00; 空或 off 关闭
# 数字人没发出来时, 代码直接发一份数据版
LARKX_BRIEFING_AT=
# 结构化记忆: 记忆文件开头写字段(类型、相关的人和群、状态、截止日期), memory/MEMORY.md 改由代码按字段生成;
# larkx memory list/lint 按字段筛选和检查。打开前手写的 MEMORY.md 会被覆盖(数字人目录有 git, 可找回)
LARKX_MEMORY_STRUCTURED=false

# 数字人发出的每条消息(包括 /stop、/clear 的回执)末尾的签名, 如: 🤖 lark-twin · 数字分身。和正文隔一个空行, 前面自动加 "—— "。留空不加
LARKX_REPLY_SIGNATURE=

# ---- 通知与告警(发到你和自己的私聊) ----

# 数字人在别的会话以你的名义发消息时, 抄送一份给你
LARKX_MIRROR=true
# 通知发往的会话; 留空 = 你和自己的私聊
LARKX_NOTIFY_CHAT=
# 你的账号用不了(如飞书登录失效)时的备用通知命令, {text} 会替换成通知内容。例: 用官方 lark-cli 的机器人身份
# LARKX_ALERT_CMD=lark-cli im +messages-send --as bot --user-id ou_xxx --text {text}
# 不要配成 larkx: daemon 里起的 larkx 会被当成数字人(按访客检查), 发不出去
LARKX_ALERT_CMD=
# 数字人 10 分钟内最多发多少条消息, 超过就拦下并告警
LARKX_SEND_RATE_LIMIT=20

# ---- 可靠性 ----

# 重启后补处理的触发消息最多是多久之前的(秒), 更早的不再回复
LARKX_INBOX_MAX_AGE=7200
# 每隔多久核对一次最近活跃的会话有没有漏收消息(秒), 0 关闭
LARKX_CATCHUP_INTERVAL=900

# ---- 网页控制台(larkx web) ----

# 控制台只监听 127.0.0.1 的这个端口, 对外由系统 Nginx 反向代理
# LARKX_WEB_PORT=18341
# 浏览器访问控制台的地址(Nginx 入口), larkx web url 用它生成登录链接; 留空 = http://127.0.0.1:<端口>
# LARKX_WEB_URL=http://<主机名>:18340

# ---- 触发规则: 哪些消息交给数字人 ----

# 触发前缀: 只处理以此前缀开头的消息(留空 = 全部处理)
LARKX_TRIGGER_PREFIX=/ai

# 本人发的 /ai 消息也交给数字人(默认开): 给它下指令、/stop、/clear、/takeover 都靠这个
# 没有触发前缀时本人的消息一律不触发; 数字人的回复也被禁止以前缀开头, 不会自己触发自己
LARKX_ALLOW_SELF=true

# 群聊/话题群里别人发的消息是否还必须 @我 才触发(默认开): 群里不带 @ 的 /ai 多半是在叫别的机器人
# 私聊不受影响; 你自己在群里发 /ai 也不受影响(不用 @ 自己); 设成 false 则群里任何人发 /ai 都会触发
# LARKX_TRIGGER_GROUP_AT_ONLY=true

# 只有本人能唤起(默认开, 安全优先): 只认你自己发的 /ai, 别人发的(私聊、群聊, 包括 @你 的)一律不触发
# 不影响: 你主动 /takeover 接管的会话(对方的话照常交给数字人)、定时任务、larkx say
# 只在唤起白名单为空时起作用: 白名单里有人时, 只有你和白名单里的人能唤起, 不看这个开关。
# 白名单不在这里配, 用 larkx whitelist add <名字> 或网页控制台的"白名单"页, 改了立即生效
# 想让所有人都能唤起(白名单为空时), 设成 false
# LARKX_TRIGGER_OWNER_ONLY=false

# 没权限的人想唤起数字人时马上自动回的一句话(不经过 agent, 不加签名, 引用回复他那条):
# "想唤起" = 私聊里发 /ai 开头的消息, 或者群里 @我 并以 /ai 开头; 换成有权限的人也不会触发的消息(群里没 @我 的 /ai、
# 普通聊天)不回。本人、机器人发的不回; 接管中的会话照常交给数字人。{owner} 换成你的飞书名字; 设成空(LARKX_DENY_REPLY=)关掉
# LARKX_DENY_REPLY=你没有权限唤起{owner}的 lark-twin
# 同一会话里同一个人多少秒内只回一次(防刷屏、防两边自动回复互相循环), 默认 600; 0 不限
# LARKX_DENY_REPLY_COOLDOWN=600

# 只在这些会话类型触发: p2p(私聊) / group(群) / topic_group(话题群),逗号分隔
# LARKX_TRIGGER_CHAT_TYPES=p2p

# 按会话、发送人过滤(和上面的唤起白名单是两回事, 一般不用): 指定群 chat_id、指定发送人 user_id(逗号分隔)
# LARKX_TRIGGER_INCLUDE_CHATS=
# LARKX_TRIGGER_EXCLUDE_CHATS=
# LARKX_TRIGGER_INCLUDE_SENDERS=

# 关键词(消息需包含其一;前缀已满足时一般不用)
# LARKX_TRIGGER_KEYWORDS=

# 登录凭证不放这里,用命令管理:
#   larkx auth qr                            扫码登录(推荐)
#   larkx auth import --cookie "<cookie>"    手动导入
